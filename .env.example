# Sao chép file này thành `.env` rồi chỉnh nếu cần
# cp .env.example .env

# ====== Postgres ======
POSTGRES_USER=rtd
POSTGRES_PASSWORD=rtd_dev_password
POSTGRES_DB=rtd_erp
POSTGRES_PORT=5432

# ====== Redis ======
REDIS_PORT=6379

# ====== Tooling ======
ADMINER_PORT=8080
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ====== Backend (sẽ dùng từ Bước 2) ======
# Lưu ý: trong container backend, host là `postgres` thay vì `localhost`
DATABASE_URL=postgresql://rtd:rtd_dev_password@localhost:5432/rtd_erp?schema=public
REDIS_URL=redis://localhost:6379

# JWT (đổi secret khi triển khai thật)
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# SMTP qua MailHog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@rtd-erp.local

# ====== Frontend (sẽ dùng từ Bước 3) ======
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
