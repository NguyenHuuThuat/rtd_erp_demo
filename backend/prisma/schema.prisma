// =====================================================================
// RTD ERP — Prisma Schema
// 8 bounded contexts: master_data, financial, inventory, manufacturing,
//                     farm, sales, procurement, events
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["master_data", "financial", "inventory", "manufacturing", "farm", "sales", "procurement", "events"]
}

// =====================================================================
// SCHEMA: master_data
// Nền tảng dùng chung: tổ chức, người dùng, RBAC, đối tác, sản phẩm,
// đơn vị tính, địa lý.
// =====================================================================

enum OrganizationType {
  GROUP
  COMPANY
  BRANCH

  @@schema("master_data")
}

model Organization {
  id           String           @id @default(uuid()) @db.Uuid
  code         String           @unique
  name         String
  type         OrganizationType
  parentId     String?          @db.Uuid
  parent       Organization?    @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Organization[]   @relation("OrgHierarchy")
  taxCode      String?
  address      String?
  provinceCode String?
  phone        String?
  email        String?
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  users       User[]
  partners    Partner[]
  warehouses  Warehouse[]
  factories   Factory[]
  farms       Farm[]
  costCenters CostCenter[]

  @@index([parentId])
  @@index([type, isActive])
  @@map("organizations")
  @@schema("master_data")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  companyId    String       @db.Uuid
  company      Organization @relation(fields: [companyId], references: [id], onDelete: Restrict)
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userRoles     UserRole[]
  refreshTokens RefreshToken[]

  @@index([companyId, isActive])
  @@map("users")
  @@schema("master_data")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
  @@schema("master_data")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
  @@schema("master_data")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String // vd "farm.pig_group"
  action      String // vd "read" | "write" | "delete" | "approve"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
  @@schema("master_data")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("master_data")
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
  @@schema("master_data")
}

enum PartnerType {
  SUPPLIER
  CUSTOMER
  BOTH
  BANK

  @@schema("master_data")
}

model Partner {
  id              String       @id @default(uuid()) @db.Uuid
  code            String
  companyId       String       @db.Uuid
  company         Organization @relation(fields: [companyId], references: [id])
  type            PartnerType
  name            String
  taxCode         String?
  address         String?
  provinceCode    String?
  phone           String?
  email           String?
  contactPerson   String?
  // Tài chính
  creditLimit     Decimal      @default(0) @db.Decimal(18, 4)
  paymentTermDays Int          @default(0)
  bankAccountNo   String?
  bankName        String?
  // Phân loại đại lý
  territoryId     String?      @db.Uuid
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  contracts           Contract[]
  salesOrders         SalesOrder[]
  purchaseOrders      PurchaseOrder[]
  invoices            Invoice[]
  payments            Payment[]
  goodsReceiptNotes   GoodsReceiptNote[]
  supplierEvaluations SupplierEvaluation[]

  @@unique([companyId, code])
  @@index([type, isActive])
  @@index([provinceCode])
  @@map("partners")
  @@schema("master_data")
}

enum ProductType {
  RAW_MATERIAL
  FINISHED_FEED
  MEDICINE
  LIVESTOCK
  PACKAGING
  OTHER

  @@schema("master_data")
}

model ProductCategory {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique
  name      String
  parentId  String?           @db.Uuid
  parent    ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  ProductCategory[] @relation("CategoryHierarchy")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  products Product[]

  @@map("product_categories")
  @@schema("master_data")
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  name           String
  type           ProductType
  categoryId     String?          @db.Uuid
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  baseUomId      String           @db.Uuid
  baseUom        Uom              @relation(fields: [baseUomId], references: [id])
  description    String?
  // Vd cho TACN: { protein: 18, fiber: 4, ash: 7, energyKcal: 3300 }
  specifications Json?            @db.JsonB
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  formulasAsOutput         Formula[]                 @relation("FormulaOutput")
  formulaLines             FormulaLine[]
  stockLots                StockLot[]
  stockMovementLines       StockMovementLine[]
  stockReservations        StockReservation[]
  stockCountLines          StockCountLine[]
  feedLogs                 FeedLog[]
  healthLogs               HealthLog[]
  vaccinationRecords       VaccinationRecord[]
  salesOrderLines          SalesOrderLine[]
  deliveryNoteLines        DeliveryNoteLine[]
  priceListItems           PriceListItem[]
  purchaseOrderLines       PurchaseOrderLine[]
  goodsReceiptLines        GoodsReceiptNoteLine[]
  invoiceLines             InvoiceLine[]
  prodOrders               ProductionOrder[]
  purchaseRequisitionLines PurchaseRequisitionLine[]

  @@index([type, isActive])
  @@index([categoryId])
  @@map("products")
  @@schema("master_data")
}

model Uom {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // kg, tấn, con, gói, lít, m³
  name      String
  precision Int      @default(2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products                 Product[]
  fromConversions          UomConversion[]           @relation("FromUom")
  toConversions            UomConversion[]           @relation("ToUom")
  salesOrderLines          SalesOrderLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  stockMovementLines       StockMovementLine[]
  priceListItems           PriceListItem[]
  goodsReceiptLines        GoodsReceiptNoteLine[]
  purchaseRequisitionLines PurchaseRequisitionLine[]

  @@map("uoms")
  @@schema("master_data")
}

model UomConversion {
  id        String  @id @default(uuid()) @db.Uuid
  fromUomId String  @db.Uuid
  toUomId   String  @db.Uuid
  factor    Decimal @db.Decimal(18, 8)
  fromUom   Uom     @relation("FromUom", fields: [fromUomId], references: [id])
  toUom     Uom     @relation("ToUom", fields: [toUomId], references: [id])

  @@unique([fromUomId, toUomId])
  @@map("uom_conversions")
  @@schema("master_data")
}

enum Region {
  NORTH
  CENTRAL
  SOUTH

  @@schema("master_data")
}

model Province {
  code   String @id // Mã GSO (vd "01" = Hà Nội)
  name   String
  region Region

  @@map("provinces")
  @@schema("master_data")
}

// ----- Cấu hình hệ thống -----

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  DATE

  @@schema("master_data")
}

model SystemSetting {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique // vd "fiscal_year_start_month", "default_currency"
  valueType   SettingValueType
  value       String // serialize theo valueType (JSON cho JSON/array)
  description String?
  category    String? // grouping: "accounting" | "general" | "security" | "i18n"
  // Settings có thể global (companyId NULL) hoặc theo công ty
  companyId   String?          @db.Uuid
  isEditable  Boolean          @default(true)
  updatedById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([key, companyId])
  @@index([category])
  @@map("system_settings")
  @@schema("master_data")
}

// ----- Quy trình phê duyệt -----

enum ApprovalFlowStatus {
  ACTIVE
  INACTIVE

  @@schema("master_data")
}

model ApprovalFlow {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique
  name        String
  // Đối tượng áp dụng: vd "PURCHASE_ORDER" | "INVOICE" | "BUDGET" | "JOURNAL"
  targetType  String
  // Điều kiện kích hoạt: ngưỡng số tiền, công ty, ... (JSONB)
  // vd { "minAmount": 100000000, "companyIds": ["..."] }
  conditions  Json?              @db.JsonB
  status      ApprovalFlowStatus @default(ACTIVE)
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  steps    ApprovalStep[]
  requests ApprovalRequest[]

  @@index([targetType, status])
  @@map("approval_flows")
  @@schema("master_data")
}

model ApprovalStep {
  id            String       @id @default(uuid()) @db.Uuid
  flowId        String       @db.Uuid
  flow          ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  sequence      Int // thứ tự bước (1, 2, 3...)
  name          String
  // Người duyệt: theo role hoặc theo user cụ thể
  approverType  String // "ROLE" | "USER" | "MANAGER_OF_REQUESTER"
  approverRefId String? @db.Uuid // roleId hoặc userId
  // Cần tất cả approver duyệt hay chỉ 1 trong số
  requireAll    Boolean      @default(false)
  // SLA tính bằng giờ
  slaHours      Int?

  decisions ApprovalDecision[]

  @@unique([flowId, sequence])
  @@map("approval_steps")
  @@schema("master_data")
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("master_data")
}

model ApprovalRequest {
  id              String                @id @default(uuid()) @db.Uuid
  code            String                @unique
  flowId          String                @db.Uuid
  flow            ApprovalFlow          @relation(fields: [flowId], references: [id])
  // Đối tượng được duyệt: vd targetType="INVOICE", targetId=<invoice.id>
  targetType      String
  targetId        String
  requesterId     String                @db.Uuid
  currentStepSeq  Int                   @default(1)
  status          ApprovalRequestStatus @default(PENDING)
  submittedAt     DateTime              @default(now())
  completedAt     DateTime?
  // Lý do, ghi chú từ requester
  notes           String?
  // Snapshot dữ liệu lúc submit (đề phòng đổi sau)
  snapshot        Json?                 @db.JsonB
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  decisions ApprovalDecision[]

  @@index([targetType, targetId])
  @@index([requesterId, status])
  @@index([status, submittedAt])
  @@map("approval_requests")
  @@schema("master_data")
}

enum ApprovalDecision_Result {
  APPROVED
  REJECTED
  RETURNED

  @@schema("master_data")
}

model ApprovalDecision {
  id         String                  @id @default(uuid()) @db.Uuid
  requestId  String                  @db.Uuid
  request    ApprovalRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepId     String                  @db.Uuid
  step       ApprovalStep            @relation(fields: [stepId], references: [id])
  approverId String                  @db.Uuid
  result     ApprovalDecision_Result
  comment    String?
  decidedAt  DateTime                @default(now())

  @@index([requestId])
  @@index([approverId, decidedAt])
  @@map("approval_decisions")
  @@schema("master_data")
}

// =====================================================================
// SCHEMA: financial
// Sổ kép đơn giản theo TT200 rút gọn, hóa đơn, thanh toán, ngân sách.
// =====================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@schema("financial")
}

model ChartOfAccount {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique // vd "111", "131", "511"
  name        String
  accountType AccountType
  parentId    String?          @db.Uuid
  parent      ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    ChartOfAccount[] @relation("AccountHierarchy")
  isLeaf      Boolean          @default(true)
  isActive    Boolean          @default(true)
  description String?
  createdAt   DateTime         @default(now())

  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@index([accountType, isActive])
  @@map("chart_of_accounts")
  @@schema("financial")
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED

  @@schema("financial")
}

enum JournalRefType {
  PURCHASE_INVOICE
  SALES_INVOICE
  PAYMENT_RECEIPT
  PAYMENT_DISBURSEMENT
  STOCK_ADJUSTMENT
  PRODUCTION
  MANUAL
  OPENING_BALANCE

  @@schema("financial")
}

model Journal {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique // JV-2026-00001
  companyId   String         @db.Uuid
  entryDate   DateTime
  description String?
  refType     JournalRefType
  refId       String?
  status      JournalStatus  @default(DRAFT)
  totalDebit  Decimal        @default(0) @db.Decimal(18, 4)
  totalCredit Decimal        @default(0) @db.Decimal(18, 4)
  createdById String?        @db.Uuid
  postedById  String?        @db.Uuid
  postedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lines JournalLine[]

  @@index([companyId, entryDate])
  @@index([status, entryDate])
  @@index([refType, refId])
  @@map("journals")
  @@schema("financial")
}

model JournalLine {
  id           String         @id @default(uuid()) @db.Uuid
  journalId    String         @db.Uuid
  journal      Journal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId    String         @db.Uuid
  account      ChartOfAccount @relation(fields: [accountId], references: [id])
  description  String?
  debit        Decimal        @default(0) @db.Decimal(18, 4)
  credit       Decimal        @default(0) @db.Decimal(18, 4)
  costCenterId String?        @db.Uuid
  costCenter   CostCenter?    @relation(fields: [costCenterId], references: [id])
  sequence     Int            @default(0)

  @@index([journalId])
  @@index([accountId])
  @@index([costCenterId])
  @@map("journal_lines")
  @@schema("financial")
}

enum InvoiceType {
  SALES
  PURCHASE

  @@schema("financial")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL_PAID
  PAID
  CANCELLED

  @@schema("financial")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique
  companyId       String        @db.Uuid
  type            InvoiceType
  partnerId       String        @db.Uuid
  partner         Partner       @relation(fields: [partnerId], references: [id])
  invoiceDate     DateTime
  dueDate         DateTime
  subtotal        Decimal       @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal       @default(0) @db.Decimal(18, 4)
  totalAmount     Decimal       @default(0) @db.Decimal(18, 4)
  paidAmount      Decimal       @default(0) @db.Decimal(18, 4)
  remainingAmount Decimal       @default(0) @db.Decimal(18, 4)
  status          InvoiceStatus @default(DRAFT)
  // Tham chiếu nguồn (sales order / purchase order)
  referenceCode   String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  lines              InvoiceLine[]
  paymentAllocations PaymentAllocation[]

  @@index([companyId, type, status])
  @@index([partnerId, invoiceDate])
  @@map("invoices")
  @@schema("financial")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id])
  description String?
  quantity    Decimal @db.Decimal(18, 6)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxRate     Decimal @default(0) @db.Decimal(5, 2) // %
  lineTotal   Decimal @db.Decimal(18, 4)

  @@index([invoiceId])
  @@map("invoice_lines")
  @@schema("financial")
}

enum PaymentType {
  RECEIPT
  DISBURSEMENT

  @@schema("financial")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CREDIT_OFFSET

  @@schema("financial")
}

enum PaymentStatus {
  DRAFT
  COMPLETED
  CANCELLED

  @@schema("financial")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique
  companyId     String        @db.Uuid
  partnerId     String        @db.Uuid
  partner       Partner       @relation(fields: [partnerId], references: [id])
  type          PaymentType
  paymentDate   DateTime
  amount        Decimal       @db.Decimal(18, 4)
  paymentMethod PaymentMethod
  bankAccountNo String?
  referenceNo   String?
  status        PaymentStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  allocations PaymentAllocation[]

  @@index([companyId, paymentDate])
  @@index([partnerId])
  @@map("payments")
  @@schema("financial")
}

model PaymentAllocation {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal @db.Decimal(18, 4)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
  @@schema("financial")
}

enum CostCenterType {
  FACTORY
  FARM
  OFFICE
  OTHER

  @@schema("financial")
}

model CostCenter {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique
  name      String
  type      CostCenterType
  companyId String         @db.Uuid
  company   Organization   @relation(fields: [companyId], references: [id])
  parentId  String?        @db.Uuid
  parent    CostCenter?    @relation("CostCenterHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  CostCenter[]   @relation("CostCenterHierarchy")
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())

  journalLines JournalLine[]
  budgetLines  BudgetLine[]

  @@map("cost_centers")
  @@schema("financial")
}

enum BudgetStatus {
  DRAFT
  APPROVED
  ACTIVE
  CLOSED

  @@schema("financial")
}

model Budget {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  companyId String       @db.Uuid
  year      Int
  name      String
  status    BudgetStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  lines BudgetLine[]

  @@unique([companyId, year, name])
  @@map("budgets")
  @@schema("financial")
}

model BudgetLine {
  id           String         @id @default(uuid()) @db.Uuid
  budgetId     String         @db.Uuid
  budget       Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId    String         @db.Uuid
  account      ChartOfAccount @relation(fields: [accountId], references: [id])
  costCenterId String?        @db.Uuid
  costCenter   CostCenter?    @relation(fields: [costCenterId], references: [id])
  month        Int // 1-12
  amount       Decimal        @db.Decimal(18, 4)

  @@unique([budgetId, accountId, costCenterId, month])
  @@index([budgetId])
  @@map("budget_lines")
  @@schema("financial")
}

// =====================================================================
// SCHEMA: inventory
// Kho, lot, dịch chuyển kho (append-only ledger), kiểm kê.
// =====================================================================

enum WarehouseType {
  RAW_MATERIAL
  FINISHED_FEED
  MEDICINE
  LIVESTOCK
  PACKAGING
  MIXED

  @@schema("inventory")
}

enum SiteType {
  FACTORY
  FARM
  OFFICE

  @@schema("inventory")
}

model Warehouse {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique
  name         String
  companyId    String        @db.Uuid
  company      Organization  @relation(fields: [companyId], references: [id])
  type         WarehouseType
  siteType     SiteType
  // Tham chiếu mềm tới Factory.id hoặc Farm.id (không bắt FK để đa hình hóa)
  siteRefId    String?       @db.Uuid
  address      String?
  provinceCode String?
  managerId    String?       @db.Uuid
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  stockLots         StockLot[]
  stockReservations StockReservation[]
  fromMovements     StockMovement[]    @relation("WarehouseFrom")
  toMovements       StockMovement[]    @relation("WarehouseTo")
  stockCounts       StockCount[]
  deliveryNotes     DeliveryNote[]
  goodsReceiptNotes GoodsReceiptNote[]

  @@index([companyId, type, isActive])
  @@index([siteType, siteRefId])
  @@map("warehouses")
  @@schema("inventory")
}

model StockLot {
  id                String    @id @default(uuid()) @db.Uuid
  code              String // số lô, không unique toàn cục — unique trong (warehouseId, productId, code)
  productId         String    @db.Uuid
  product           Product   @relation(fields: [productId], references: [id])
  warehouseId       String    @db.Uuid
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  mfgDate           DateTime?
  expiryDate        DateTime?
  supplierPartnerId String?   @db.Uuid
  // Truy nguyên nguồn: GRN, PRODUCTION_BATCH, ...
  originDocType     String?
  originDocId       String?
  createdAt         DateTime  @default(now())

  movementLines StockMovementLine[]

  @@unique([warehouseId, productId, code])
  @@index([productId, expiryDate])
  @@map("stock_lots")
  @@schema("inventory")
}

enum StockMoveType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT

  @@schema("inventory")
}

enum StockMoveRefType {
  PURCHASE_RECEIPT
  PRODUCTION_OUT
  PRODUCTION_IN
  SALES_DELIVERY
  WAREHOUSE_TRANSFER
  STOCK_COUNT_ADJUSTMENT
  FEED_CONSUMPTION
  MEDICINE_CONSUMPTION
  MORTALITY_WRITEOFF
  MANUAL

  @@schema("inventory")
}

enum StockMoveStatus {
  DRAFT
  POSTED
  CANCELLED

  @@schema("inventory")
}

model StockMovement {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  companyId       String           @db.Uuid
  type            StockMoveType
  moveDate        DateTime
  fromWarehouseId String?          @db.Uuid
  fromWarehouse   Warehouse?       @relation("WarehouseFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?          @db.Uuid
  toWarehouse     Warehouse?       @relation("WarehouseTo", fields: [toWarehouseId], references: [id])
  refType         StockMoveRefType
  refId           String?
  status          StockMoveStatus  @default(DRAFT)
  notes           String?
  postedAt        DateTime?
  createdById     String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lines StockMovementLine[]

  @@index([companyId, moveDate])
  @@index([refType, refId])
  @@index([type, status])
  @@map("stock_movements")
  @@schema("inventory")
}

model StockMovementLine {
  id         String        @id @default(uuid()) @db.Uuid
  movementId String        @db.Uuid
  movement   StockMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  productId  String        @db.Uuid
  product    Product       @relation(fields: [productId], references: [id])
  lotId      String?       @db.Uuid
  lot        StockLot?     @relation(fields: [lotId], references: [id])
  quantity   Decimal       @db.Decimal(18, 6)
  uomId      String        @db.Uuid
  uom        Uom           @relation(fields: [uomId], references: [id])
  unitCost   Decimal       @default(0) @db.Decimal(18, 4)

  @@index([movementId])
  @@index([productId])
  @@map("stock_movement_lines")
  @@schema("inventory")
}

enum ReservedFor {
  SALES_ORDER
  PRODUCTION_ORDER

  @@schema("inventory")
}

model StockReservation {
  id          String      @id @default(uuid()) @db.Uuid
  productId   String      @db.Uuid
  product     Product     @relation(fields: [productId], references: [id])
  warehouseId String      @db.Uuid
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  quantity    Decimal     @db.Decimal(18, 6)
  reservedFor ReservedFor
  refId       String      @db.Uuid
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([productId, warehouseId])
  @@index([reservedFor, refId])
  @@map("stock_reservations")
  @@schema("inventory")
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("inventory")
}

model StockCount {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  companyId   String           @db.Uuid
  warehouseId String           @db.Uuid
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  countDate   DateTime
  status      StockCountStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lines StockCountLine[]

  @@index([companyId, countDate])
  @@map("stock_counts")
  @@schema("inventory")
}

model StockCountLine {
  id          String     @id @default(uuid()) @db.Uuid
  countId     String     @db.Uuid
  count       StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId   String     @db.Uuid
  product     Product    @relation(fields: [productId], references: [id])
  expectedQty Decimal    @db.Decimal(18, 6)
  actualQty   Decimal    @db.Decimal(18, 6)
  varianceQty Decimal    @db.Decimal(18, 6)
  notes       String?

  @@index([countId])
  @@map("stock_count_lines")
  @@schema("inventory")
}

// =====================================================================
// SCHEMA: manufacturing
// Nhà máy, dây chuyền, công thức TACN, lệnh sản xuất, QC.
// =====================================================================

model Factory {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  name         String
  companyId    String       @db.Uuid
  company      Organization @relation(fields: [companyId], references: [id])
  address      String?
  provinceCode String?
  managerId    String?      @db.Uuid
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  machineLines     MachineLine[]
  productionOrders ProductionOrder[]

  @@map("factories")
  @@schema("manufacturing")
}

model MachineLine {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  factoryId         String   @db.Uuid
  factory           Factory  @relation(fields: [factoryId], references: [id])
  capacityKgPerHour Decimal  @default(0) @db.Decimal(18, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  productionBatches ProductionBatch[]

  @@map("machine_lines")
  @@schema("manufacturing")
}

enum FormulaStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@schema("manufacturing")
}

model Formula {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique
  name            String
  // Sản phẩm đầu ra (FINISHED_FEED)
  outputProductId String        @db.Uuid
  outputProduct   Product       @relation("FormulaOutput", fields: [outputProductId], references: [id])
  targetSpecs     Json?         @db.JsonB // {protein: 18, fiber: 4, ash: 7, energyKcal: 3300}
  version         Int           @default(1)
  status          FormulaStatus @default(DRAFT)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  companyId       String        @db.Uuid
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines            FormulaLine[]
  productionOrders ProductionOrder[]
  feedLogs         FeedLog[]

  @@index([companyId, status])
  @@map("formulas")
  @@schema("manufacturing")
}

model FormulaLine {
  id         String  @id @default(uuid()) @db.Uuid
  formulaId  String  @db.Uuid
  formula    Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  // Nguyên liệu (RAW_MATERIAL)
  productId  String  @db.Uuid
  product    Product @relation(fields: [productId], references: [id])
  percentage Decimal @db.Decimal(7, 4) // % theo khối lượng (0-100)
  tolerance  Decimal @default(0) @db.Decimal(5, 2)
  sequence   Int     @default(0)

  @@index([formulaId])
  @@map("formula_lines")
  @@schema("manufacturing")
}

enum ProductionOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("manufacturing")
}

model ProductionOrder {
  id              String                @id @default(uuid()) @db.Uuid
  code            String                @unique
  companyId       String                @db.Uuid
  factoryId       String                @db.Uuid
  factory         Factory               @relation(fields: [factoryId], references: [id])
  formulaId       String                @db.Uuid
  formula         Formula               @relation(fields: [formulaId], references: [id])
  // Lưu lại sản phẩm đầu ra để tra cứu nhanh (snapshot tại thời điểm tạo)
  outputProductId String                @db.Uuid
  outputProduct   Product               @relation(fields: [outputProductId], references: [id])
  plannedQty      Decimal               @db.Decimal(18, 4) // kg
  producedQty     Decimal               @default(0) @db.Decimal(18, 4)
  plannedStartAt  DateTime
  plannedEndAt    DateTime
  status          ProductionOrderStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  batches ProductionBatch[]

  @@index([companyId, status, plannedStartAt])
  @@index([factoryId])
  @@map("production_orders")
  @@schema("manufacturing")
}

enum ProductionBatchStatus {
  PLANNED
  RUNNING
  FINISHED
  FAILED

  @@schema("manufacturing")
}

model ProductionBatch {
  id                String                @id @default(uuid()) @db.Uuid
  code              String                @unique
  productionOrderId String                @db.Uuid
  productionOrder   ProductionOrder       @relation(fields: [productionOrderId], references: [id])
  machineLineId     String                @db.Uuid
  machineLine       MachineLine           @relation(fields: [machineLineId], references: [id])
  batchDate         DateTime
  plannedQty        Decimal               @db.Decimal(18, 4)
  actualQty         Decimal               @default(0) @db.Decimal(18, 4)
  startTime         DateTime?
  endTime           DateTime?
  operatorId        String?               @db.Uuid
  status            ProductionBatchStatus @default(PLANNED)
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  qcRecords QcRecord[]

  @@index([productionOrderId])
  @@index([machineLineId, batchDate])
  @@map("production_batches")
  @@schema("manufacturing")
}

enum QcResult {
  PASS
  FAIL
  RETEST

  @@schema("manufacturing")
}

model QcRecord {
  id         String          @id @default(uuid()) @db.Uuid
  batchId    String          @db.Uuid
  batch      ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sampledAt  DateTime
  qcById     String?         @db.Uuid
  protein    Decimal?        @db.Decimal(7, 4)
  moisture   Decimal?        @db.Decimal(7, 4)
  ash        Decimal?        @db.Decimal(7, 4)
  fiber      Decimal?        @db.Decimal(7, 4)
  energyKcal Decimal?        @db.Decimal(10, 2)
  result     QcResult
  notes      String?
  createdAt  DateTime        @default(now())

  @@index([batchId])
  @@map("qc_records")
  @@schema("manufacturing")
}

// =====================================================================
// SCHEMA: farm
// Trại, dãy, ô, đàn lợn (cohort), feed/health/weight/mortality, CV alerts.
// =====================================================================

enum FarmType {
  SOW_FARM
  GROWER_FINISHER
  BREEDING
  NURSERY
  MIXED

  @@schema("farm")
}

model Farm {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  name         String
  companyId    String       @db.Uuid
  company      Organization @relation(fields: [companyId], references: [id])
  type         FarmType
  address      String?
  provinceCode String?
  managerId    String?      @db.Uuid
  capacity     Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  barns     Barn[]
  pigGroups PigGroup[]
  cvAlerts  CvAlert[]

  @@index([companyId, isActive])
  @@map("farms")
  @@schema("farm")
}

model Barn {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  name      String
  farmId    String   @db.Uuid
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  capacity  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  pens     Pen[]
  cvAlerts CvAlert[]

  @@unique([farmId, code])
  @@map("barns")
  @@schema("farm")
}

model Pen {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  name      String?
  barnId    String   @db.Uuid
  barn      Barn     @relation(fields: [barnId], references: [id], onDelete: Cascade)
  capacity  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Đàn đang ở ô — quan hệ ngược của PigGroup.currentPenId.
  // Trạng thái "ô trống" = không có PigGroup nào tham chiếu.
  groups   PigGroup[]
  cvAlerts CvAlert[]

  @@unique([barnId, code])
  @@map("pens")
  @@schema("farm")
}

enum PigStage {
  PIGLET
  WEANER
  GROWER
  FINISHER
  SOW
  BOAR

  @@schema("farm")
}

enum PigGroupStatus {
  ACTIVE
  SOLD_OUT
  CULLED
  MOVED

  @@schema("farm")
}

model PigGroup {
  id                 String         @id @default(uuid()) @db.Uuid
  code               String         @unique
  farmId             String         @db.Uuid
  farm               Farm           @relation(fields: [farmId], references: [id])
  currentPenId       String?        @db.Uuid
  currentPen         Pen?           @relation(fields: [currentPenId], references: [id])
  stage              PigStage
  breed              String?
  inDate             DateTime
  expectedOutDate    DateTime?
  initialCount       Int
  currentCount       Int
  mortalityCount     Int            @default(0)
  soldCount          Int            @default(0)
  avgInWeightKg      Decimal        @db.Decimal(8, 3)
  avgCurrentWeightKg Decimal        @default(0) @db.Decimal(8, 3)
  status             PigGroupStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  feedLogs           FeedLog[]
  healthLogs         HealthLog[]
  vaccinationRecords VaccinationRecord[]
  weightLogs         WeightLog[]
  mortalityRecords   MortalityRecord[]
  cvAlerts           CvAlert[]

  @@index([farmId, status])
  @@index([stage])
  @@map("pig_groups")
  @@schema("farm")
}

model FeedLog {
  id            String   @id @default(uuid()) @db.Uuid
  groupId       String   @db.Uuid
  group         PigGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  feedDate      DateTime
  formulaId     String?  @db.Uuid
  formula       Formula? @relation(fields: [formulaId], references: [id])
  feedProductId String   @db.Uuid
  feedProduct   Product  @relation(fields: [feedProductId], references: [id])
  quantityKg    Decimal  @db.Decimal(18, 4)
  recordedById  String?  @db.Uuid
  notes         String?
  createdAt     DateTime @default(now())

  @@index([groupId, feedDate])
  @@map("feed_logs")
  @@schema("farm")
}

model HealthLog {
  id                String   @id @default(uuid()) @db.Uuid
  groupId           String   @db.Uuid
  group             PigGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recordDate        DateTime
  diagnosis         String
  treatment         String?
  medicineProductId String?  @db.Uuid
  medicineProduct   Product? @relation(fields: [medicineProductId], references: [id])
  dosage            String?
  withholdingDays   Int?
  vetId             String?  @db.Uuid
  notes             String?
  createdAt         DateTime @default(now())

  @@index([groupId, recordDate])
  @@map("health_logs")
  @@schema("farm")
}

model VaccinationRecord {
  id               String    @id @default(uuid()) @db.Uuid
  groupId          String    @db.Uuid
  group            PigGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  vaccineProductId String    @db.Uuid
  vaccineProduct   Product   @relation(fields: [vaccineProductId], references: [id])
  vaccinationDate  DateTime
  dosage           String?
  batchNo          String?
  vetId            String?   @db.Uuid
  nextDueDate      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())

  @@index([groupId, vaccinationDate])
  @@map("vaccination_records")
  @@schema("farm")
}

model WeightLog {
  id           String   @id @default(uuid()) @db.Uuid
  groupId      String   @db.Uuid
  group        PigGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  weighDate    DateTime
  sampleSize   Int
  avgWeightKg  Decimal  @db.Decimal(8, 3)
  minWeightKg  Decimal? @db.Decimal(8, 3)
  maxWeightKg  Decimal? @db.Decimal(8, 3)
  stdDev       Decimal? @db.Decimal(8, 3)
  recordedById String?  @db.Uuid
  notes        String?
  createdAt    DateTime @default(now())

  @@index([groupId, weighDate])
  @@map("weight_logs")
  @@schema("farm")
}

model MortalityRecord {
  id           String   @id @default(uuid()) @db.Uuid
  groupId      String   @db.Uuid
  group        PigGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  eventDate    DateTime
  count        Int
  cause        String
  notes        String?
  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  @@index([groupId, eventDate])
  @@map("mortality_records")
  @@schema("farm")
}

enum CvAlertType {
  COUGH
  FEVER
  LIMP
  AGGRESSION
  ABNORMAL_BEHAVIOR
  FEED_LOW
  WATER_LEAK
  TEMPERATURE_HIGH
  TEMPERATURE_LOW
  OTHER

  @@schema("farm")
}

enum CvAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("farm")
}

enum CvAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE

  @@schema("farm")
}

model CvAlert {
  id           String          @id @default(uuid()) @db.Uuid
  farmId       String          @db.Uuid
  farm         Farm            @relation(fields: [farmId], references: [id])
  barnId       String?         @db.Uuid
  barn         Barn?           @relation(fields: [barnId], references: [id])
  penId        String?         @db.Uuid
  pen          Pen?            @relation(fields: [penId], references: [id])
  groupId      String?         @db.Uuid
  group        PigGroup?       @relation(fields: [groupId], references: [id])
  alertType    CvAlertType
  severity     CvAlertSeverity
  confidence   Decimal         @db.Decimal(4, 3) // 0.000 - 1.000
  detectedAt   DateTime
  cameraId     String
  imageUrl     String?
  payload      Json?           @db.JsonB
  status       CvAlertStatus   @default(OPEN)
  ackById      String?         @db.Uuid
  ackAt        DateTime?
  resolvedById String?         @db.Uuid
  resolvedAt   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())

  @@index([farmId, status, detectedAt])
  @@index([severity, status])
  @@map("cv_alerts")
  @@schema("farm")
}

// =====================================================================
// SCHEMA: sales
// Đại lý, vùng, bảng giá, đơn hàng, xuất giao.
// =====================================================================

model Territory {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  companyId     String   @db.Uuid
  // Danh sách mã tỉnh phủ sóng (chuẩn GSO)
  provinceCodes String[]
  managerId     String?  @db.Uuid
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesOrders SalesOrder[]

  @@map("territories")
  @@schema("sales")
}

enum SalesChannel {
  AGENT
  RETAIL
  INTERNAL
  EXPORT

  @@schema("sales")
}

enum PriceListStatus {
  DRAFT
  ACTIVE
  EXPIRED

  @@schema("sales")
}

model PriceList {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique
  name      String
  companyId String          @db.Uuid
  channel   SalesChannel
  validFrom DateTime
  validTo   DateTime?
  status    PriceListStatus @default(DRAFT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  items PriceListItem[]

  @@index([companyId, status])
  @@map("price_lists")
  @@schema("sales")
}

model PriceListItem {
  id          String    @id @default(uuid()) @db.Uuid
  priceListId String    @db.Uuid
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id])
  uomId       String    @db.Uuid
  uom         Uom       @relation(fields: [uomId], references: [id])
  price       Decimal   @db.Decimal(18, 4)
  minQty      Decimal   @default(0) @db.Decimal(18, 6)
  discount    Decimal   @default(0) @db.Decimal(5, 2)

  @@unique([priceListId, productId, uomId, minQty])
  @@map("price_list_items")
  @@schema("sales")
}

enum ContractType {
  SUPPLY
  FRAMEWORK
  SPOT

  @@schema("sales")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED

  @@schema("sales")
}

model Contract {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique
  companyId       String         @db.Uuid
  customerId      String         @db.Uuid
  customer        Partner        @relation(fields: [customerId], references: [id])
  contractType    ContractType
  startDate       DateTime
  endDate         DateTime?
  creditLimit     Decimal        @default(0) @db.Decimal(18, 4)
  paymentTermDays Int            @default(0)
  status          ContractStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  salesOrders SalesOrder[]

  @@index([companyId, status])
  @@index([customerId])
  @@map("contracts")
  @@schema("sales")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
  INVOICED

  @@schema("sales")
}

model SalesOrder {
  id                   String           @id @default(uuid()) @db.Uuid
  code                 String           @unique
  companyId            String           @db.Uuid
  customerId           String           @db.Uuid
  customer             Partner          @relation(fields: [customerId], references: [id])
  contractId           String?          @db.Uuid
  contract             Contract?        @relation(fields: [contractId], references: [id])
  territoryId          String?          @db.Uuid
  territory            Territory?       @relation(fields: [territoryId], references: [id])
  orderDate            DateTime
  expectedDeliveryDate DateTime
  status               SalesOrderStatus @default(DRAFT)
  subtotal             Decimal          @default(0) @db.Decimal(18, 4)
  taxAmount            Decimal          @default(0) @db.Decimal(18, 4)
  totalAmount          Decimal          @default(0) @db.Decimal(18, 4)
  deliveredAmount      Decimal          @default(0) @db.Decimal(18, 4)
  notes                String?
  createdById          String?          @db.Uuid
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  lines         SalesOrderLine[]
  deliveryNotes DeliveryNote[]

  @@index([companyId, status, orderDate])
  @@index([customerId])
  @@map("sales_orders")
  @@schema("sales")
}

model SalesOrderLine {
  id           String     @id @default(uuid()) @db.Uuid
  orderId      String     @db.Uuid
  order        SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String     @db.Uuid
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Decimal    @db.Decimal(18, 6)
  deliveredQty Decimal    @default(0) @db.Decimal(18, 6)
  uomId        String     @db.Uuid
  uom          Uom        @relation(fields: [uomId], references: [id])
  unitPrice    Decimal    @db.Decimal(18, 4)
  taxRate      Decimal    @default(0) @db.Decimal(5, 2)
  lineTotal    Decimal    @db.Decimal(18, 4)
  // Vd nguồn hàng: PIG_GROUP cho heo, FINISHED_FEED cho cám
  sourceType   String?
  sourceRefId  String?

  deliveryLines DeliveryNoteLine[]

  @@index([orderId])
  @@index([productId])
  @@map("sales_order_lines")
  @@schema("sales")
}

enum DeliveryStatus {
  DRAFT
  IN_TRANSIT
  DELIVERED
  CANCELLED

  @@schema("sales")
}

model DeliveryNote {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique
  companyId       String         @db.Uuid
  orderId         String         @db.Uuid
  order           SalesOrder     @relation(fields: [orderId], references: [id])
  fromWarehouseId String         @db.Uuid
  fromWarehouse   Warehouse      @relation(fields: [fromWarehouseId], references: [id])
  deliveryDate    DateTime
  vehicleNo       String?
  driverName      String?
  toAddress       String?
  toContact       String?
  status          DeliveryStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines DeliveryNoteLine[]

  @@index([companyId, deliveryDate])
  @@index([orderId])
  @@map("delivery_notes")
  @@schema("sales")
}

model DeliveryNoteLine {
  id             String         @id @default(uuid()) @db.Uuid
  deliveryNoteId String         @db.Uuid
  deliveryNote   DeliveryNote   @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  orderLineId    String         @db.Uuid
  orderLine      SalesOrderLine @relation(fields: [orderLineId], references: [id])
  productId      String         @db.Uuid
  product        Product        @relation(fields: [productId], references: [id])
  quantity       Decimal        @db.Decimal(18, 6)
  lotId          String?        @db.Uuid

  @@index([deliveryNoteId])
  @@index([orderLineId])
  @@map("delivery_note_lines")
  @@schema("sales")
}

// =====================================================================
// SCHEMA: procurement
// Yêu cầu mua, đơn mua, nhập kho, đánh giá NCC.
// =====================================================================

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED

  @@schema("procurement")
}

model PurchaseRequisition {
  id            String                    @id @default(uuid()) @db.Uuid
  code          String                    @unique
  companyId     String                    @db.Uuid
  requestedById String                    @db.Uuid
  department    String?
  requestDate   DateTime
  neededDate    DateTime
  status        PurchaseRequisitionStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  lines          PurchaseRequisitionLine[]
  purchaseOrders PurchaseOrder[]

  @@index([companyId, status])
  @@map("purchase_requisitions")
  @@schema("procurement")
}

model PurchaseRequisitionLine {
  id             String              @id @default(uuid()) @db.Uuid
  requisitionId  String              @db.Uuid
  requisition    PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  productId      String              @db.Uuid
  product        Product             @relation(fields: [productId], references: [id])
  quantity       Decimal             @db.Decimal(18, 6)
  uomId          String              @db.Uuid
  uom            Uom                 @relation(fields: [uomId], references: [id])
  estimatedPrice Decimal             @default(0) @db.Decimal(18, 4)
  notes          String?

  @@index([requisitionId])
  @@map("purchase_requisition_lines")
  @@schema("procurement")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@schema("procurement")
}

model PurchaseOrder {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique
  companyId           String               @db.Uuid
  supplierId          String               @db.Uuid
  supplier            Partner              @relation(fields: [supplierId], references: [id])
  requisitionId       String?              @db.Uuid
  requisition         PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  orderDate           DateTime
  expectedReceiveDate DateTime
  paymentTermDays     Int                  @default(0)
  status              PurchaseOrderStatus  @default(DRAFT)
  subtotal            Decimal              @default(0) @db.Decimal(18, 4)
  taxAmount           Decimal              @default(0) @db.Decimal(18, 4)
  totalAmount         Decimal              @default(0) @db.Decimal(18, 4)
  receivedAmount      Decimal              @default(0) @db.Decimal(18, 4)
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  lines             PurchaseOrderLine[]
  goodsReceiptNotes GoodsReceiptNote[]

  @@index([companyId, status, orderDate])
  @@index([supplierId])
  @@map("purchase_orders")
  @@schema("procurement")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String        @db.Uuid
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(18, 6)
  receivedQty     Decimal       @default(0) @db.Decimal(18, 6)
  uomId           String        @db.Uuid
  uom             Uom           @relation(fields: [uomId], references: [id])
  unitPrice       Decimal       @db.Decimal(18, 4)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal       @db.Decimal(18, 4)

  grnLines GoodsReceiptNoteLine[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
  @@schema("procurement")
}

enum GrnStatus {
  DRAFT
  RECEIVED
  QC_PENDING
  QC_PASSED
  QC_FAILED

  @@schema("procurement")
}

model GoodsReceiptNote {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique
  companyId       String        @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String        @db.Uuid
  supplier        Partner       @relation(fields: [supplierId], references: [id])
  toWarehouseId   String        @db.Uuid
  toWarehouse     Warehouse     @relation(fields: [toWarehouseId], references: [id])
  receiptDate     DateTime
  vehicleNo       String?
  deliveryDocRef  String?
  status          GrnStatus     @default(DRAFT)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines GoodsReceiptNoteLine[]

  @@index([companyId, receiptDate])
  @@index([purchaseOrderId])
  @@map("goods_receipt_notes")
  @@schema("procurement")
}

model GoodsReceiptNoteLine {
  id                  String            @id @default(uuid()) @db.Uuid
  grnId               String            @db.Uuid
  grn                 GoodsReceiptNote  @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String            @db.Uuid
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  productId           String            @db.Uuid
  product             Product           @relation(fields: [productId], references: [id])
  quantity            Decimal           @db.Decimal(18, 6)
  uomId               String            @db.Uuid
  uom                 Uom               @relation(fields: [uomId], references: [id])
  lotCode             String?
  mfgDate             DateTime?
  expiryDate          DateTime?
  qcStatus            GrnStatus?
  notes               String?

  @@index([grnId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_note_lines")
  @@schema("procurement")
}

model SupplierEvaluation {
  id             String   @id @default(uuid()) @db.Uuid
  supplierId     String   @db.Uuid
  supplier       Partner  @relation(fields: [supplierId], references: [id])
  evaluationDate DateTime
  period         String // "Q1-2026"
  qualityScore   Int // 1-5
  onTimeScore    Int
  priceScore     Int
  overallScore   Decimal  @db.Decimal(4, 2)
  evaluatedById  String?  @db.Uuid
  notes          String?
  createdAt      DateTime @default(now())

  @@index([supplierId, evaluationDate])
  @@map("supplier_evaluations")
  @@schema("procurement")
}

// =====================================================================
// SCHEMA: events
// Outbox pattern (publish event), audit log, idempotency.
// =====================================================================

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("events")
}

model Outbox {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String // vd "PigGroup", "SalesOrder"
  aggregateId   String
  eventType     String // vd "farm.pig_group.created"
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox")
  @@schema("events")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  entity    String
  entityId  String
  action    String // CREATE | UPDATE | DELETE | APPROVE | ...
  actorId   String?  @db.Uuid
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  companyId String?  @db.Uuid
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([companyId, createdAt])
  @@map("audit_logs")
  @@schema("events")
}

model IdempotencyKey {
  key                String   @id
  requestHash        String
  responseStatusCode Int
  responseBody       Json?    @db.JsonB
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("events")
}
