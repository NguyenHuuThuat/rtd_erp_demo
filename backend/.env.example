# Backend env
# Khi chạy Prisma từ máy host: dùng localhost:5432
# Khi chạy Prisma trong container `backend`: đổi host thành `postgres`
DATABASE_URL=postgresql://rtd:rtd_dev_password@localhost:5432/rtd_erp?schema=public

REDIS_URL=redis://localhost:6379

PORT=3001
NODE_ENV=development

JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@rtd-erp.local

# Bật seed dữ liệu 6 tháng (Bước 5)
SEED_DEMO_DATA=true
SEED_RANDOM_SEED=42
